# Local development and Docker Compose; never commit real keys.
DATABASE_URL=sqlite:///./qala.db
POSTGRES_PASSWORD=qala-local-dev
WEB_PORT=3000
# Set a random 32+ character secret for persistent sessions across restarts.
SESSION_SECRET=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
# Choose a model available to your OpenAI project. Optional; no paid API required.
OPENAI_MODEL=
VISION_ENABLED=false
YOLO_MODEL=yolo11n.pt
